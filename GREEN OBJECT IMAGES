# Green Object Detection
# Computer Vision Program 57
# Run with: python 06_color_segmentation/57_green_detection.py

import cv2, numpy as np
img=np.zeros((300,400,3),np.uint8); cv2.circle(img,(200,150),70,(0,255,0),-1)
hsv=cv2.cvtColor(img,cv2.COLOR_BGR2HSV)
m=cv2.inRange(hsv,(35,100,100),(85,255,255))
print("Green pixels:",cv2.countNonZero(m))
