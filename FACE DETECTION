import cv2
cascade=cv2.data.haarcascades+"haarcascade_frontalface_default.xml"
det=cv2.CascadeClassifier(cascade)
img=cv2.imread("sample_face.jpg")
if img is None: print("Place a face image as sample_face.jpg")
else: print("Faces:",len(det.detectMultiScale(cv2.cvtColor(img,cv2.COLOR_BGR2GRAY),1.1,5)))
