import cv2
from helper import sample_image
gray = cv2.cvtColor(sample_image(), cv2.COLOR_BGR2GRAY)
out = cv2.Laplacian(gray,cv2.CV_64F)
cv2.imwrite("laplacian.jpg", cv2.convertScaleAbs(out))
print("Laplacian applied")
