# Adaptive Threshold
# Computer Vision Program 30
# Run with: python 03_image_enhancement/30_adaptive_threshold.py

import cv2
from helper import sample_image
gray = cv2.cvtColor(sample_image(), cv2.COLOR_BGR2GRAY)
out = cv2.adaptiveThreshold(gray,255,cv2.ADAPTIVE_THRESH_GAUSSIAN_C,cv2.THRESH_BINARY,11,2)
cv2.imwrite("adaptive.jpg", out)
print("Adaptive threshold applied")
