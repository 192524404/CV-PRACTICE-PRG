# Closing
# Computer Vision Program 39
# Run with: python 04_segmentation_edges/39_closing.py

import cv2, numpy as np
from helper import sample_image
g = cv2.cvtColor(sample_image(), cv2.COLOR_BGR2GRAY)
k=np.ones((5,5),np.uint8)
out=cv2.morphologyEx(g,cv2.MORPH_CLOSE,k)
cv2.imwrite("closing.jpg",out)
print("Closing applied")
