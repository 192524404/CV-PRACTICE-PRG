import cv2
from helper import sample_image
img=sample_image()
hsv=cv2.cvtColor(img,cv2.COLOR_BGR2HSV)
mask=cv2.inRange(hsv,(35,80,50),(90,255,255))
n,_=cv2.connectedComponents(mask)
print("Color regions:",n-1)
