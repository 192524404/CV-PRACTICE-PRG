import cv2
import numpy as np

def sample_image():
    img = np.zeros((400, 600, 3), dtype=np.uint8)
    cv2.rectangle(img, (60, 60), (250, 250), (255, 120, 30), -1)
    cv2.circle(img, (430, 180), 80, (30, 220, 80), -1)
    cv2.line(img, (50, 330), (550, 330), (255, 255, 255), 5)
    cv2.putText(img, "Computer Vision", (130, 380),
                cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2)
    return img
