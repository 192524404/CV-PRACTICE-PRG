# Computer Vision Program 83
# Run with: python 09_detection/83_smile_detection.py

import cv2
sm=cv2.CascadeClassifier(cv2.data.haarcascades+"haarcascade_smile.xml")
img=cv2.imread("sample_face.jpg")
if img is None: print("Place sample_face.jpg")
else: print("Smiles:",len(sm.detectMultiScale(cv2.cvtColor(img,cv2.COLOR_BGR2GRAY),1.7,20)))
