import cv2
cap=cv2.VideoCapture("sample.avi"); count=0
while True:
 ok,f=cap.read()
 if not ok: break
 g=cv2.cvtColor(f,cv2.COLOR_BGR2GRAY); count+=1
cap.release(); print("Grayscale frames:",count)
